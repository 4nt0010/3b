rules_version = '2';
// Regole di sicurezza per 3B Interrogazioni.
// Da incollare in Firebase Console → Firestore Database → Regole → Pubblica.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Ruolo admin: ognuno può solo controllare se stesso. Si modifica solo dalla console.
    match /admins/{id} {
      allow get: if signedIn() && id == me();
      allow list, write: if false;
    }

    // Anagrafica studenti: visibile a tutti gli iscritti (serve per i nomi nel calendario).
    // Lo studente può solo segnare di aver letto le regole.
    match /students/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && id == me() && onlyChanged(['rulesAccepted']) && request.resource.data.rulesAccepted == true);
    }

    match /subjects/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Interrogazioni: visibili a tutti. Verifiche: solo agli studenti assegnati.
    match /events/{id} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.type == 'interrogazione' || me() in resource.data.studentIds));
      allow write: if isAdmin();
    }

    match /rounds/{rid} {
      function round() { return get(/databases/$(database)/documents/rounds/$(rid)).data; }
      function canVote() {
        return round().status == 'voting'
          || (round().get('revote', {}).get('active', false) == true && me() in round().get('revote', {}).get('students', []));
      }
      function validVote() {
        let d = request.resource.data;
        return d.keys().hasOnly(['first', 'reserve', 'updatedAt'])
          && (d.first == null || (d.first is string && d.first in round().dates))
          && (d.reserve == null || (d.reserve is string && d.reserve in round().dates))
          && (d.first == null || d.first != d.reserve);
      }

      // Le bozze le vede solo l'admin
      allow read: if isAdmin() || (signedIn() && resource.data.visible == true);
      allow write: if isAdmin();

      // Capienza e ipotesi di sorteggio: SOLO admin
      match /private/{docId} {
        allow read, write: if isAdmin();
      }

      // Voti: ognuno vede il proprio; gli altri solo se l'admin attiva "Mostra voti"
      match /votes/{vid} {
        allow get: if isAdmin() || (signedIn() && (vid == me() || round().showVotes == true));
        allow list: if isAdmin() || (signedIn() && round().showVotes == true);
        allow create, update: if signedIn() && vid == me() && canVote() && validVote();
        allow delete: if isAdmin();
      }
    }

    // Giorni esclusi: li vede solo lo studente interessato
    match /exclusions/{sid} {
      allow read: if isAdmin() || (signedIn() && sid == me());
      allow write: if isAdmin();
    }

    match /recoveries/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == me());
      allow write: if isAdmin();
    }

    // Scambi: proposti da A, accettati da B, approvati dall'admin
    match /swaps/{id} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.fromUid == me() || resource.data.toUid == me()));
      allow create: if signedIn()
        && request.resource.data.fromUid == me()
        && request.resource.data.toUid != me()
        && request.resource.data.status == 'pending_peer';
      allow update: if isAdmin()
        || (signedIn() && resource.data.toUid == me() && resource.data.status == 'pending_peer'
            && request.resource.data.status in ['pending_admin', 'declined'] && onlyChanged(['status', 'updatedAt']))
        || (signedIn() && resource.data.fromUid == me() && resource.data.status in ['pending_peer', 'pending_admin']
            && request.resource.data.status == 'cancelled' && onlyChanged(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }
  }
}
